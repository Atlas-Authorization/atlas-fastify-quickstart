# Atlas + Fastify quickstart — copy to .env and fill in your instance's values.
# Load it with `node --env-file=.env src/server.js` (Node 20+).

# Local JWT verification (used by @atlasauth/fastify). No secret key needed.
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net

# Optional — only used for the cross-property handshake / azp checks.
ATLAS_PUBLISHABLE_KEY=pk_test_xxx

PORT=3000
